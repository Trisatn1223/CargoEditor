# Add to the EXISTING Caddyfile; keep the existing API domain untouched.
# /api is same-origin from the browser, and Caddy forwards to the API.
cargo-editor.dreamislandstudio.de {
    encode zstd gzip
    handle_path /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy cargo-editor:8080
    }
}
